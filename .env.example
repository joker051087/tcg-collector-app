\# URL du backend local (voir dossier server/ et README.md, section "Backend").
\# Depuis un navigateur sur ce même PC, "localhost" fonctionne. Depuis ton
\# téléphone (Expo Go), remplace-le par l'IP locale de ton PC, ex :
\# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

\# Connexion Google + sauvegarde en ligne (voir GUIDE_FIREBASE.md à la racine
\# du projet pour savoir où récupérer chaque valeur). Laisser vide désactive
\# proprement la connexion (le bouton affiche juste un message d'indisponibilité).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
