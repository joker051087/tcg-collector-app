{
  "expo": {
    "name": "TCG Collector",
    "slug": "tcg-collector-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "tcgcollector",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.tcgcollector"
    },
    "android": {
      "package": "com.yourcompany.tcgcollector",
      "adaptiveIcon": {
        "backgroundColor": "#0f0f13"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "TCG Collector a besoin de l'appareil photo pour scanner tes cartes."
        }
      ]
    ]
  }
}
